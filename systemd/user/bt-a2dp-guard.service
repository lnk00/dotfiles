[Unit]
Description=Recover Bluetooth audio stuck in HSP/HFP (mono 8kHz robot sound)
Documentation=man:pactl(1)
After=pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service

[Service]
Type=simple
ExecStart=%h/.local/bin/bt-a2dp-guard
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
