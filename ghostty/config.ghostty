theme = E-Ink
font-family = "GeistMono Nerd Font Mono"

window-padding-x = 8
window-padding-y = 8

keybind = ctrl+j=scroll_page_lines:3
keybind = ctrl+k=scroll_page_lines:-3
keybind = ctrl+v=paste_from_clipboard

keybind = super+alt+equal=new_split:right
keybind = super+alt+minus=new_split:down
# keybind = super+alt+backslash=new_split:right
# keybind = super+alt+slash=new_split:down

keybind = super+alt+h=goto_split:left
keybind = super+alt+j=goto_split:down
keybind = super+alt+k=goto_split:up
keybind = super+alt+l=goto_split:right

keybind = super+alt+enter=toggle_split_zoom

# >>> eink theme (generated -- edit ~/.config/theme/eink.toml) >>>
font-thicken = true
cursor-style-blink = false
# <<< eink theme <<<
