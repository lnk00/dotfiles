theme = E-Ink
font-family = "GeistMono Nerd Font Mono"

window-padding-x = 8
window-padding-y = 8

keybind = ctrl+j=scroll_page_lines:3
keybind = ctrl+k=scroll_page_lines:-3
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+s=copy_to_clipboard

# Release ctrl+, (ghostty's default open_config) so it reaches neovim,
# where it clears multicursors.
keybind = ctrl+,=unbind

keybind = super+alt+equal=new_split:right
keybind = super+alt+minus=new_split:down

keybind = super+alt+h=goto_split:left
keybind = super+alt+j=goto_split:down
keybind = super+alt+k=goto_split:up
keybind = super+alt+l=goto_split:right

keybind = ctrl+alt+h=resize_split:left,100
keybind = ctrl+alt+j=resize_split:down,100
keybind = ctrl+alt+k=resize_split:up,100
keybind = ctrl+alt+l=resize_split:right,100

keybind = super+alt+f=toggle_split_zoom

# >>> eink theme (generated -- edit ~/.config/theme/eink.toml) >>>
font-thicken = true
cursor-style-blink = false
# <<< eink theme <<<
