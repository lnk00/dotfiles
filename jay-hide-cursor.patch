+    fn pointer_used(&self) {
+        self.last_pointer_ns.set(self.state.now_nsec());
+        if self.cursor_hidden.replace(false) {
+            self.cursor_shown.trigger();
+        }
+    }
+
+    /// Hides the cursor once the pointer has been idle for `CURSOR_HIDE_DELAY_NS`.
+    ///
+    /// Hiding deactivates the cursor group, which stops both the hardware and the
+    /// software cursor from being drawn. The next pointer event activates the pointer
+    /// cursor again.
+    pub(super) fn create_cursor_hider(self: &Rc<Self>) {
+        let slf = self.clone();
+        let handle = self.state.eng.spawn("cursor hider", async move {
+            loop {
+                let deadline_ns = slf.last_pointer_ns.get() + CURSOR_HIDE_DELAY_NS;
+                if slf.state.now_nsec() < deadline_ns {
+                    if let Err(e) = slf.state.ring.timeout(deadline_ns).await {
+                        log::error!("Could not wait for cursor timeout: {}", ErrorFmt(e));
+                        return;
+                    }
+                    continue;
+                }
+                slf.cursor_hidden.set(true);
+                slf.cursor_user_group.deactivate();
+                slf.cursor_shown.triggered().await;
+            }
+        });
+        self.cursor_hider.set(Some(handle));
+    }
 }
 
