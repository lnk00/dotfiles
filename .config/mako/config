# Behaviour lives here, colours live in the theme (same split as alacritty).

# Jay puts its bar at the bottom, so the top-right corner is free.
anchor=top-right
layer=top
width=380
height=160
outer-margin=10
margin=6
padding=10,14
icons=1
max-icon-size=32
icon-location=left
markup=1
default-timeout=6000
max-visible=4
max-history=20
sort=-time
group-by=app-name,summary

on-button-left=invoke-default-action
on-button-middle=dismiss-all
on-button-right=dismiss

include=~/.config/mako/themes/e-ink-dark

# makoctl mode -a do-not-disturb  /  makoctl mode -r do-not-disturb
[mode=do-not-disturb]
invisible=1
