# $HOME is a dumping ground. Ignore everything; opt in explicitly.
# A new app's files will NOT show up in `git status` until added here.
#
# Note: gitignore has no trailing comments -- a `#` after a pattern is part
# of the pattern. Every comment here is on its own line.
#
# Note: a negation cannot re-include a file whose parent directory is still
# ignored. That is why every entry comes in a `!/dir/` + `!/dir/**` pair, and
# why `/.config/` has to be un-ignored before anything inside it can be.
*

# --- repo metadata ---
!/.gitignore
!/README.md

# --- shell + git, at the top level of $HOME ---
!/.bashrc
!/.bash_profile
!/.inputrc
!/.gitconfig
# .inputrc.bak is a scratch copy, not config
# .bash_history, .ssh, .gnupg are secrets or machine state
# .claude holds .credentials.json -- never allow it

# --- ~/.config ---
!/.config/

# --- wayland desktop ---
!/.config/jay/
!/.config/jay/**
!/.config/mako/
!/.config/mako/**

# --- terminal + editor ---
!/.config/alacritty/
!/.config/alacritty/**
!/.config/nvim/
!/.config/nvim/**
!/.config/starship/
!/.config/starship/**

# --- cli tools ---
!/.config/lazygit/
!/.config/lazygit/**

# --- browser: config only. qsettings/ is Qt file-dialog state (window
# geometry, last-visited path, a base64 header blob) and greasemonkey/ is
# empty. The dir must be un-ignored before a file inside it can be included.
!/.config/qutebrowser/
/.config/qutebrowser/*
!/.config/qutebrowser/config.py
!/.config/qutebrowser/autoconfig.yml
!/.config/qutebrowser/quickmarks
!/.config/qutebrowser/bookmarks/
!/.config/qutebrowser/bookmarks/urls

# --- system ---
!/.config/wireplumber/
!/.config/wireplumber/**
!/.config/mimeapps.list
# the xbps package list, regenerated by the `export-package` alias
!/.config/packages.txt

# --- deliberately never tracked ---
# .config/gh          -- hosts.yml is a live OAuth token
# .config/github-copilot -- auth.db is a Copilot token
# .config/pulse       -- cookie is a binary auth cookie
# .config/go          -- telemetry counter cache
